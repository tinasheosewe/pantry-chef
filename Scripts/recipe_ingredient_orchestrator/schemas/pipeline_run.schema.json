{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pantrychef.local/schemas/recipe-ingredient-pipeline-run.schema.json",
  "title": "Recipe Ingredient Pipeline Run",
  "type": "object",
  "required": [
    "kind",
    "version",
    "run_id",
    "started_at",
    "generated_at",
    "duration_seconds",
    "spec",
    "recipe_candidate",
    "ingredient_mentions",
    "resolution_records",
    "resolved_recipe",
    "validation",
    "attempt_history",
    "generation_attempts",
    "exportedRecipe"
  ],
  "properties": {
    "kind": {
      "const": "recipe-ingredient-pipeline-run"
    },
    "version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "spec": {
      "type": "object",
      "required": ["dish_id", "title", "servings"],
      "properties": {
        "dish_id": {"type": "string"},
        "title": {"type": "string"},
        "cuisine": {"type": ["string", "null"]},
        "meal_type": {"type": ["string", "null"]},
        "servings": {"type": "integer"}
      }
    },
    "recipe_candidate": {
      "type": "object",
      "required": ["recipe_id", "title", "ingredients", "steps", "servings", "difficulty"],
      "properties": {
        "recipe_id": {"type": "string"},
        "title": {"type": "string"},
        "description": {"type": ["string", "null"]},
        "servings": {"type": "integer"},
        "prep_time_minutes": {"type": ["integer", "null"]},
        "cook_time_minutes": {"type": ["integer", "null"]},
        "difficulty": {"type": "integer"},
        "dietary_tags": {"type": "array", "items": {"type": "string"}},
        "meal_type": {"type": ["string", "null"]},
        "cuisine": {"type": ["string", "null"]},
        "source": {"type": "string"},
        "ingredients": {"type": "array", "minItems": 1},
        "steps": {"type": "array", "minItems": 1}
      }
    },
    "ingredient_mentions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mention_id", "raw_name", "quantity", "category"]
      }
    },
    "resolution_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mention_id",
          "status",
          "confidence",
          "rationale",
          "candidates"
        ],
        "properties": {
          "status": {
            "enum": ["resolved", "unresolved"]
          }
        }
      }
    },
    "resolved_recipe": {
      "type": "object",
      "required": ["recipe_id", "title", "ingredients", "steps", "servings", "difficulty"],
      "properties": {
        "recipe_id": {"type": "string"},
        "title": {"type": "string"},
        "description": {"type": ["string", "null"]},
        "servings": {"type": "integer"},
        "prep_time_minutes": {"type": ["integer", "null"]},
        "cook_time_minutes": {"type": ["integer", "null"]},
        "difficulty": {"type": "integer"},
        "dietary_tags": {"type": "array", "items": {"type": "string"}},
        "meal_type": {"type": ["string", "null"]},
        "cuisine": {"type": ["string", "null"]},
        "source": {"type": "string"},
        "ingredients": {"type": "array", "minItems": 1},
        "steps": {"type": "array", "minItems": 1}
      }
    },
    "validation": {
      "type": "object",
      "required": ["is_valid", "errors", "warnings"]
    },
    "review": {
      "type": ["object", "null"]
    },
    "attempt_history": {
      "type": "array"
    },
    "generation_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "failure_code": {
      "type": ["string", "null"]
    },
    "exportedRecipe": {
      "type": "object",
      "required": ["title", "ingredients", "steps"]
    }
  },
  "additionalProperties": true
}